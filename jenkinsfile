pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Show Current Containers') {
            steps {
                sh 'docker ps -a || true'
            }
        }

        stage('Build Images') {
            steps {
                sh 'docker compose build'
            }
        }

        stage('Cleanup Old Deployment') {
            steps {
                sh '''
                docker compose down --remove-orphans || true

                docker rm -f backend frontend 2>/dev/null || true

                docker rm -f calculator-ci-cd-backend-1 calculator-ci-cd-frontend-1 2>/dev/null || true
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                docker compose up -d --build
                '''
            }
        }

        stage('Verify') {
            steps {
                sh '''
                docker ps
                '''
            }
        }
    }

    post {

        success {
            echo '✅ Deployment Successful'
        }

        failure {
            echo '❌ Deployment Failed'
            sh 'docker ps -a || true'
        }
    }
}
